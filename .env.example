# ShiftWise environment variables template
# Copy to .env and adjust values for your deployment.

# Stable, random 32-byte session secret key (generate with: python3 -c 'import secrets; print(secrets.token_hex(32))')
SHIFTWISE_SECRET_KEY=replace_with_32_byte_hex_token

# Initial manager password for bootstrap/migration (at least 12 characters)
SHIFTWISE_BOOTSTRAP_MANAGER_PASSWORD=replace_with_strong_manager_password

# Public hostname for Caddy TLS and reverse proxy
SHIFTWISE_PUBLIC_HOSTNAME=localhost

# Contact email for Let's Encrypt ACME certificate registration
SHIFTWISE_ACME_EMAIL=admin@example.com

# Demo seed data (demo ONLY: set to 1 to seed the 8-employee mock roster and
# shifts on initial start; keep 0 for any real deployment)
SHIFTWISE_DEMO_SEED=0

# Cookie and proxy hardening (enabled by default in docker-compose.yml)
SHIFTWISE_BEHIND_PROXY=1
SHIFTWISE_SESSION_COOKIE_SECURE=1

# Schedule-link delivery. Set the public HTTPS URL employees can reach.
SHIFTWISE_PUBLIC_URL=https://shiftwise.example.com

# Email via SMTP (587 with STARTTLS). SMTP username/password are optional
# only when your SMTP server does not require authentication.
SHIFTWISE_SMTP_HOST=smtp.example.com
SHIFTWISE_SMTP_PORT=587
SHIFTWISE_SMTP_USER=replace_with_smtp_username
SHIFTWISE_SMTP_PASSWORD=replace_with_smtp_password
SHIFTWISE_SMTP_FROM=schedules@example.com

# Text messages via Twilio. Leave unset if using email only.
SHIFTWISE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHIFTWISE_TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
SHIFTWISE_TWILIO_FROM=+15550000000
